# Copy to .env and fill in real values before `docker compose up -d`

# Panel token-signing secret — generate with: openssl rand -hex 32
KGPANEL_SECRET=change-me-generate-with-openssl-rand-hex-32

# Shared secret between panel and wings (any strong random string)
KGWINGS_TOKEN=change-me-to-a-long-random-string

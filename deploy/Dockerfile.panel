# ---- build stage ----
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY panel/go.mod panel/go.sum* ./
RUN go mod download || true
COPY panel/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/kgpanel ./cmd/kgpanel

# ---- runtime ----
FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/kgpanel /app/kgpanel
EXPOSE 8080
VOLUME ["/data"]
ENTRYPOINT ["/app/kgpanel"]
